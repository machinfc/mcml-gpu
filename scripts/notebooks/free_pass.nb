Cell[CellGroupData[{
Cell["\<\
Analisis del recorrido libre de los fotones\
\>", "Section",
 CellChangeTimes->{{3.6012202955049477`*^9, 3.601220313991446*^9}, {
  3.601221171575431*^9, 3.601221173950205*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2.5", ",", "250", ",", "0.01"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.7", ",", "125", ",", "0.25"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.2", ",", "125", ",", "2.5"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"No", "=", "100000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", " ", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", "3"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sum", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Capa \>\"", ",", "i"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"n", "=", "1"}], ",", 
      RowBox[{"n", "<", "No"}], ",", 
      RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Lambda]", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log", "[", 
           RowBox[{"Random", "[", "]"}], "]"}]}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"layers", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], "+", 
           RowBox[{"layers", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sum", "=", 
        RowBox[{"sum", "+", "\[Lambda]"}]}], ";"}]}], "\[IndentingNewLine]", 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"sum", "/", "No"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.601220347193112*^9, 3.601220360092038*^9}, {
  3.6012204673534184`*^9, 3.601220687129991*^9}, {3.6012207220011377`*^9, 
  3.601221084243981*^9}}],

