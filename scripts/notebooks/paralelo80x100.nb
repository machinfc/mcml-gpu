Notebook[{

Cell[CellGroupData[{
Cell["\<\
Procesamiento de los datos de piel normal usando mcml con fuente paralela
 Nr=100, Nz=80,dr=dz=0.005\
\>", "Section",
 CellChangeTimes->{{3.600531237001974*^9, 3.600531302273488*^9}, {
  3.6007910517890863`*^9, 3.600791085657605*^9}, {3.600799276430689*^9, 
  3.600799301071899*^9}, {3.6012212733328943`*^9, 3.601221273767365*^9}}],

Cell["\<\
Datos iniciales y abriendo el fichero\
\>", "Text",
 CellChangeTimes->{{3.600531200392067*^9, 3.60053120909484*^9}, {
  3.600531381358202*^9, 3.600531425081624*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nr", "=", "100"}], ";", 
  RowBox[{"Nz", "=", "80"}], ";", 
  RowBox[{"dr", "=", "0.005"}], ";", 
  RowBox[{"dz", "=", "0.005"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layers", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2.5", ",", "250", ",", "0.01"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.7", ",", "125", ",", "0.25"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.2", ",", "125", ",", "2.5"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zlayer", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "52", ",", "83"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "SetDirectory", "[", 
   "\"\</home/nelia/Documents/Photodynamics/fluence/mcmlcode/paralelo/80x100\>\
\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"OpenRead", "[", "\"\<paralelo107.mco\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.600531096634824*^9, 3.600531100721302*^9}, {
   3.60053114241059*^9, 3.600531185570627*^9}, {3.6005312185400763`*^9, 
   3.600531233778392*^9}, {3.600531346151387*^9, 3.600531385551098*^9}, {
   3.6005319598294888`*^9, 3.600531965356765*^9}, {3.60060546669342*^9, 
   3.600605483813788*^9}, {3.600605722989193*^9, 3.600605725155741*^9}, {
   3.600606428336124*^9, 3.600606429705518*^9}, {3.600606466691707*^9, 
   3.600606477789539*^9}, {3.60060743945442*^9, 3.60060747960953*^9}, {
   3.600607541566364*^9, 3.600607618188999*^9}, {3.60060774245925*^9, 
   3.600607867193244*^9}, {3.600608455546346*^9, 3.600608459426853*^9}, {
   3.600609454993576*^9, 3.60060945702336*^9}, {3.600610455143904*^9, 
   3.600610456046894*^9}, 3.600610502653267*^9, {3.600615078624111*^9, 
   3.600615099333204*^9}, {3.600789540125515*^9, 3.600789542818639*^9}, {
   3.600790078726856*^9, 3.6007901759910603`*^9}, {3.600790246585091*^9, 
   3.600790252454853*^9}, {3.600790304569784*^9, 3.600790314691278*^9}, 
   3.600790362419942*^9, {3.600799260873535*^9, 3.600799274119234*^9}, {
   3.600799320524805*^9, 3.600799354731348*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "\[LessEqual]", "10"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Find", "[", 
      RowBox[{"out", ",", "\"\<A[nr-1][0]\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Read", "[", 
      RowBox[{"out", ",", "Word"}], "]"}], ";", "\[IndentingNewLine]", 
     "\"\<Numero de photones\>\"", ";", "\[IndentingNewLine]", 
     RowBox[{"photons", "=", 
      RowBox[{"Read", "[", 
       RowBox[{"out", ",", "Number"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Arz", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"l", "=", "1"}], ";", "\[IndentingNewLine]", 
     "\"\<Leyendo los valores de Arz, guardandolos y normalizando\>\"", " ", 
     ";", "\[IndentingNewLine]", 
     "\"\<\!\(\*FractionBox[\(Arz\), \(\[CapitalDelta]V\\\ N_fotones\)]\) \
\>\"", ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "\[LessEqual]", " ", "Nr"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"Arz", ",", 
         RowBox[{
          RowBox[{"ReadList", "[", 
           RowBox[{"out", ",", "Number", ",", "Nz"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Pi]", " ", 
            SuperscriptBox["dr", "2"], "dz", 
            RowBox[{"(", 
             RowBox[{"j", "-", "0.5"}], ")"}], " ", "photons"}], " ", 
           ")"}]}]}], "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "\"\<Graficos de Arz\>\"", ";", 
     "\[IndentingNewLine]", 
     "\"\<Calculando la fluencia \[Phi]=Arz/\[Mu]a\>\"", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<=", "Nz"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"\[Phi]", ",", 
          RowBox[{
           RowBox[{"Arz", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "j"}], "]"}], "]"}], "/", 
           RowBox[{"layers", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "1"}], "]"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", 
           RowBox[{"zlayer", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", 
          RowBox[{"k", "++"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
      "\[IndentingNewLine]", "\"\<Graficos de \[Phi]\>\"", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"photons", "\[Equal]", "1000000"}], "||", 
        RowBox[{"photons", "\[Equal]", "10000000"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"photons", ",", "\"\< Fotones\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        "\"\<Print[ListContourPlot[Arz,ImageSize\[Rule]Medium],ListPlot[Arz[[\
1]],ImageSize\[Rule]Medium]];\>\"", ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"ListContourPlot", "[", 
           RowBox[{"\[Phi]", ",", 
            RowBox[{"ImageSize", "\[Rule]", "Medium"}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", "\"\<Fluence\>\""}]}], "]"}], ",", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"\[Phi]", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "10"}], "]"}], "]"}], ",", 
            RowBox[{"ImageSize", "\[Rule]", "Medium"}]}], "]"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.600531434546969*^9, 3.6005315087957897`*^9}, {
   3.6005317307671824`*^9, 3.6005319226242943`*^9}, {3.600531974131119*^9, 
